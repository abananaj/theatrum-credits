{
  "name": "theatrum-credits",
  "version": "1.0.0",
  "scripts": {
    "build:blocks": "wp-scripts build",
    "build:manager": "webpack --config webpack.credits-manager.js",
    "build:watch": "webpack --config webpack.credits-manager.js --watch",
    "build": "npm run build:blocks && npm run build:manager",
    "start:blocks": "wp-scripts start",
    "start:manager": "webpack --config webpack.credits-manager.js --watch --mode development"
  },
  "devDependencies": {
    "@babel/runtime": "^7.0.0",
    "@wordpress/eslint-plugin": "^25.10.0",
    "@wordpress/scripts": "^32.0.0",
    "eslint": "^9.39.5"
  }
}
